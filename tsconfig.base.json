{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "paths": {
      "@ambientalia/shared": ["./packages/shared/src/index.ts"],
      "@ambientalia/zoho-sync/*": ["./packages/zoho-sync/src/*"]
    }
  }
}
