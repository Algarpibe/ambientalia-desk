ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ORG_ID=<tu_org_id>
ZOHO_DEPARTMENT_ID=<tu_department_id>
ZOHO_ACCOUNTS_DOMAIN=accounts.zoho.com
ZOHO_API_DOMAIN=desk.zoho.com
ENABLE_WRITES=false
PORT=3001
DATABASE_URL=postgres://usuario:password@host:5432/basededatos
SYNC_INTERVAL_MS=180000

# Remisiones: la app dispara el flujo de n8n y n8n contesta por callback.
# Son DOS secretos distintos que viajan en direcciones opuestas.
N8N_REMISION_WEBHOOK_URL=
N8N_REMISION_TOKEN=          # lo manda la app en X-Remision-Token; lo valida n8n
REMISION_CALLBACK_TOKEN=     # lo manda n8n en X-Remision-Callback; lo valida la app

# Avisos por correo: flujo de n8n PROPIO, distinto del de remisiones. Vacio = canal apagado y la
# campana sigue funcionando igual.
N8N_AVISOS_WEBHOOK_URL=
N8N_AVISOS_TOKEN=            # lo manda la app en X-Avisos-Token; lo valida n8n
APP_BASE_URL=                # URL publica de la app, para el enlace del correo
# Muleta de la fase de pruebas: copia de los avisos de DERIVACION dirigidos a otras personas, para
# poder verificar que el correo sale. Los avisos de AREA no se copian, porque al administrador ya le
# llegan como destinatario. Se apaga borrando la variable.
AVISOS_COPIA_EMAIL=

# Solo en el worker. Puntual: repuebla books.contacts para traer direccion/telefono/persona
# de contacto, que solo llegan por el detalle. ~615 GET a Books. Apagar tras usarlo.
BACKFILL_CONTACTS=false

# Mark-and-sweep de huerfanos (borra de la replica lo eliminado en Zoho)
SWEEP_ENABLED=false
SWEEP_DRY_RUN=true
SWEEP_HOUR=4
SWEEP_MAX_ROWS=200
SWEEP_MAX_PCT=0.1

# DECISIONALES_POR_CARGO: con `true`, las transiciones Decisionales sólo las ejecutan el Director o el Coordinador de su área (y el Especialista técnico con el Coordinador Técnico vacante); no encender antes del 14/12/2026 ni sin asignar antes los cargos de permiso. Ausente o con otro valor, todo como antes.
DECISIONALES_POR_CARGO=
# CONTROL_CALIDAD_LIBERACION: con `true`, el servicio pasa por Control de calidad antes de Por Facturar (firma quien no intervino) y se habilita la calibración directa; se enciende en enero junto con DECISIONALES_POR_CARGO, nunca antes del 14/12/2026. Ausente o con otro valor, todo como antes.
CONTROL_CALIDAD_LIBERACION=
# SALIDAS_ESPERAS: con `true`, las esperas externas ganan la salida «cobro de diagnóstico» y «Solicitado» gana «sin pieza en almacén»; el cobro y la anulación desde las esperas externas los ejecutan sólo el Director Comercial o la Coordinadora Comercial (y el administrador), y el cobro pide un motivo que queda en el historial. No encender antes del 14/12/2026, lo decide Gerencia; encendido sin nadie con esos cargos, sólo el administrador puede cobrar o anular desde ellas. Ausente o con otro valor, todo como antes y las dos transiciones nuevas responden 409.
SALIDAS_ESPERAS=
# SYNC_CONVERSACIONES_PERIODICA: con `true`, la App pide en cada ciclo las conversaciones de los tickets modificados (1G-01, DEPLOY.md §18). Vacía = apagada.
SYNC_CONVERSACIONES_PERIODICA=
# MARCAR_CONVERSACIONES_AUSENTES: con `true`, la App oculta las conversaciones que Zoho ya no devuelve, sin borrarlas (1G-01, DEPLOY.md §19). Vacía = apagada.
MARCAR_CONVERSACIONES_AUSENTES=
# Relleno completo de conversaciones (1G-01, DEPLOY.md §21). Enciende POST /api/admin/relleno-conversaciones; abierta por descuido, un superadministrador puede lanzar el barrido entero contra la cuota de Zoho Desk. Vacía = cerrada.
RELLENO_CONVERSACIONES_HABILITADO=
# 1G-02 · Ruta absoluta del volumen donde se guardan los adjuntos de Zoho, fuera de dist/. Vacía, relativa o dentro de dist/, nada se guarda y los adjuntos se sirven desde Zoho.
ADJUNTOS_DIR=
# 1G-02 · Abre POST /api/admin/relleno-adjuntos (sólo superadministrador) para descargar de Zoho los adjuntos sin copia. Abierta por descuido permite soltar la descarga entera contra la cuota de Zoho y el disco; sólo abre con el literal true.
RELLENO_ADJUNTOS_HABILITADO=
# 1G-02 · Con SYNC_CONVERSACIONES_PERIODICA=true, la pasada periódica guarda los adjuntos nuevos, hasta 20 por ciclo. Con un volumen pequeño llena el disco ciclo a ciclo; sólo abre con el literal true.
GUARDAR_ADJUNTOS_AL_SINCRONIZAR=
# VERIFICACION_COMPLETITUD_HABILITADA (1G-03, DEPLOY.md §23). Qué enciende: que un superadministrador lance POST /api/admin/verificacion-completitud, la pasada de sólo lectura que compara Zoho Desk con Desk. Qué se rompe si se pone mal: abierta por descuido gasta cuota diaria de Zoho Desk, compartida con la sincronización; cualquier valor distinto de 'true' la deja cerrada y el POST responde 403.
VERIFICACION_COMPLETITUD_HABILITADA=
# 1G-04 · Con true, ninguna petición sale hacia Zoho Desk (ni la del token) y la app sirve sólo lo que hay en PostgreSQL; va en los DOS servicios, App y worker hub-sync (DEPLOY.md §24). Puesta en uno solo el otro sigue llamando a Zoho, y abierta no se puede responder a un cliente por correo desde la app; sólo abre con el literal true.
MODO_SIN_ZOHO_DESK=false